rules_version = '2';
service cloud::firestore {
  match /databases/{database}/documents {

    // Global Safety Net Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isIncomingOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // SavedIdeas Collection
    match /savedIdeas/{ideaId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // Scripts Collection
    match /scripts/{scriptId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // SEOReports Collection
    match /seoReports/{reportId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // Analytics Collection
    match /analytics/{recordId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // Settings Collection
    match /settings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if false;
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // GrowthReports Collection
    match /growthReports/{reportId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // ContentCalendar Collection
    match /contentCalendar/{eventId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }

    // SavedProjects Collection
    match /savedProjects/{projectId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isIncomingOwner();
      allow update: if isSignedIn() && isDocOwner() && isIncomingOwner();
      allow delete: if isSignedIn() && isDocOwner();
    }
  }
}
